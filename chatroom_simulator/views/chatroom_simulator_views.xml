<odoo>
    <record id="action_chatroom_simulator" model="ir.actions.act_window">
        <field name="name">ChatRoom Simulator</field>
        <field name="res_model">chatroom.room</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unassigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Development Tools
            </p>
            <p>
                Use the simulator endpoints to create test data:
            </p>
            <ul>
                <li><code>/chatroom/simulate/new_chat</code> - Create a new chat</li>
                <li><code
                >/chatroom/simulate/message</code> - Add a message to existing chat</li>
                <li><code>/chatroom/simulate/batch</code> - Create multiple chats</li>
            </ul>
            <p>
                Or use the JavaScript console in your OWL components to call these endpoints.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_chatroom_simulator"
        name="🔧 Simulator"
        parent="chatroom.menu_chatroom_config"
        action="action_chatroom_simulator"
        sequence="10"
    />
</odoo>
