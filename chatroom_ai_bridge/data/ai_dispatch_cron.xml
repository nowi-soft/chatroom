<odoo>
    <record id="cron_dispatch_due_ai" model="ir.cron">
        <field name="name">ChatRoom: AI debounced dispatch</field>
        <field name="model_id" ref="chatroom.model_chatroom_room" />
        <field name="state">code</field>
        <field name="code">model._cron_dispatch_due_ai()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
