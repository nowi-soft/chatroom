<odoo>
    <record id="res_config_settings_view_form_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom_ai_bridge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="chatroom.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='chatroom']" position="inside">
                <block name="chatroom_ai_settings" title="AI Assistant">
                    <setting
                        id="chatroom_ai_response_delay_setting"
                        string="AI response delay"
                        help="Seconds the AI waits after the last incoming message before replying. Each new message resets the timer, so a burst of messages gets a single combined reply. 0 = reply immediately."
                    >
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="chatroom_ai_response_delay"
                                    class="o_light_label"
                                /> seconds
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
