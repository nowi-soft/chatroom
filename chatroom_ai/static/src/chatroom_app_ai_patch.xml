<templates xml:space="preserve">


    <t
        t-name="chatroom.ChatroomApp"
        t-inherit="chatroom.ChatroomApp"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[@class='chatroom-sidebar']" position="inside">
            <div
                t-if="state.managementRoom"
                class="ai-setup-sidebar-btn"
                t-att-class="{'active': state.currentRoom?.id === state.managementRoom?.id}"
                t-on-click="openManagementRoom"
            >
                <i class="fa fa-robot"/>
                <span>AI Setup</span>
            </div>
        </xpath>

        <xpath
            expr="//t[@t-foreach='state.myChats']/div[@class='chat-item']"
            position="attributes"
        >
            <attribute
                name="t-att-class"
            >this.getChatItemClass ? this.getChatItemClass(chat) : { active: state.currentRoom?.id === chat.id }</attribute>
        </xpath>

        <xpath
            expr="//t[@t-foreach='state.unassignedChats']/div[@class='chat-item']"
            position="attributes"
        >
            <attribute
                name="t-att-class"
            >this.getChatItemClass ? this.getChatItemClass(chat) : { active: state.currentRoom?.id === chat.id }</attribute>
        </xpath>

        <xpath expr="//div[@class='message']" position="attributes">
            <attribute name="t-att-class">{
                'message-incoming': msg.direction === 'incoming' and !msg.is_internal,
                'message-outgoing': msg.direction === 'outgoing' and !msg.is_internal,
                'message-ai': msg.is_ai_generated,
                'message-note': msg.is_internal
            }</attribute>
        </xpath>

        <xpath
            expr="//div[@class='messages-header']/div[@class='header-left']"
            position="after"
        >
            <div class="header-center">
                <div class="ai-controls" t-if="state.currentRoom and state.currentRoom.id !== state.managementRoom?.id">
                    <div
                        t-if="!state.currentRoom.ai_enabled"
                        class="d-flex align-items-center gap-2"
                    >
                        <button
                            class="btn btn-sm btn-success"
                            t-on-click="() => this.toggleAI(state.currentRoom)"
                        >
                            <i class="fa fa-robot" /> Enable AI
                        </button>
                    </div>
                    <div t-else="" class="d-flex align-items-center gap-2">
                        <span class="badge bg-success">
                            <i class="fa fa-robot" /> AI Agent Active
                        </span>
                        <button
                            class="btn btn-sm btn-danger"
                            t-on-click="() => this.toggleAI(state.currentRoom)"
                        >
                            <i class="fa fa-pause" /> Disable AI
                        </button>
                    </div>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@class='chat-meta']" position="inside">
            <div t-if="chat.ai_enabled" class="chat-ai-badge">
                <i class="fa fa-robot" /> AI
            </div>
        </xpath>

        <xpath expr="//div[@class='audio-caption']" position="after">
            <t t-if="msg.is_transcribing">
                <div class="message-body text-muted fst-italic mt-2">
                    <i class="fa fa-spinner fa-spin" /> Transcribing...
                </div>
            </t>
            <t t-elif="msg.is_transcription_failed">
                <div class="message-body text-danger mt-2">
                    <i class="fa fa-times-circle" /> Transcription failed
                </div>
            </t>
            <t t-elif="msg.is_transcribed and msg.body">
                <div class="message-body mt-2">
                    <span t-out="msg.body" />
                    <span
                        class="badge bg-info ms-2"
                        style="font-size: 0.75em;"
                        title="Transcribed by AI"
                    >
                        <i class="fa fa-magic" /> Transcribed by AI
                    </span>
                </div>
            </t>
        </xpath>
    </t>

</templates>
