<odoo>
    <record id="channel_ai" model="queue.job.channel">
        <field name="name">root.ai</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>

    <record id="job_function_chatroom_message_process_ai" model="queue.job.function">
        <field name="model_id" ref="chatroom.model_chatroom_message" />
        <field name="method">_job_process_room_messages</field>
        <field name="channel_id" ref="channel_ai" />
        <field name="retry_pattern" eval="{1: 30, 2: 120, 3: 300}" />
    </record>
</odoo>
