<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="chatroom.res_config_settings_view_form" />
        <field name="priority" eval="95" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='chatroom_messages_settings']" position="after">
                <block name="chatroom_ai_settings" title="AI Processing">
                    <setting id="chatroom_ai_message_batch_delay_setting">
                        <field name="chatroom_ai_message_batch_delay" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
