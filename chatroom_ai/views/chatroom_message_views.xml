<odoo>
    <!-- Inherit chatroom.message list view to add AI fields -->
    <record id="view_chatroom_message_list_ai" model="ir.ui.view">
        <field name="name">chatroom.message.list.ai</field>
        <field name="model">chatroom.message</field>
        <field name="inherit_id" ref="chatroom.view_chatroom_message_list" />
        <field name="arch" type="xml">
            <field name="message_type" position="after">
                <field name="is_ai_generated" />
                <field name="ai_processing_state" optional="hide" />
                <field name="ai_processing_date" optional="hide" />
            </field>
        </field>
    </record>

    <!-- Inherit chatroom.message form view to add AI fields -->
    <record id="view_chatroom_message_form_ai" model="ir.ui.view">
        <field name="name">chatroom.message.form.ai</field>
        <field name="model">chatroom.message</field>
        <field name="inherit_id" ref="chatroom.view_chatroom_message_form" />
        <field name="arch" type="xml">
            <field name="message_type" position="after">
                <field name="is_ai_generated" />
            </field>
            <field name="create_date" position="after">
                <field name="is_internal" />
            </field>
            <field name="body" position="after">
                <group
                    string="AI Processing"
                    invisible="direction != 'incoming' or is_internal"
                >
                    <group>
                        <field name="ai_pending_processing" />
                        <field name="ai_processing_state" />
                    </group>
                    <group>
                        <field name="ai_processing_date" />
                    </group>
                    <field
                        name="ai_processing_error"
                        invisible="not ai_processing_error"
                    />
                </group>
            </field>
        </field>
    </record>

    <!-- Inherit chatroom.message search view to add AI filters -->
    <record id="view_chatroom_message_search_ai" model="ir.ui.view">
        <field name="name">chatroom.message.search.ai</field>
        <field name="model">chatroom.message</field>
        <field name="inherit_id" ref="chatroom.view_chatroom_message_search" />
        <field name="arch" type="xml">
            <filter name="product" position="after">
                <separator />
                <filter
                    string="AI Generated"
                    name="ai_generated"
                    domain="[('is_ai_generated', '=', True)]"
                />
                <filter
                    string="Pending AI Processing"
                    name="ai_pending"
                    domain="[('ai_processing_state', '=', 'pending')]"
                />
                <filter
                    string="AI Processing"
                    name="ai_processing"
                    domain="[('ai_processing_state', '=', 'processing')]"
                />
                <filter
                    string="AI Failed"
                    name="ai_failed"
                    domain="[('ai_processing_state', '=', 'failed')]"
                />
            </filter>
            <filter name="group_type" position="after">
                <filter
                    string="AI Processing State"
                    name="group_ai_state"
                    context="{'group_by': 'ai_processing_state'}"
                />
            </filter>
        </field>
    </record>
</odoo>
