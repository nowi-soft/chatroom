<odoo>
    <record id="view_chatroom_ai_provider_tree" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.tree</field>
        <field name="model">chatroom.ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="name" />
                <field name="provider_type" />
                <field name="default_model" />
                <field
                    name="state"
                    decoration-success="state == 'active'"
                    decoration-danger="state == 'error'"
                />
                <field name="total_requests" />
                <field name="total_tokens_used" />
            </list>
        </field>
    </record>

    <record id="view_chatroom_ai_provider_search" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.search</field>
        <field name="model">chatroom.ai.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="provider_type" />
                <separator />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="view_chatroom_ai_provider_form" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.form</field>
        <field name="model">chatroom.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Provider Name" />
                        </h1>
                    </div>
                    <group>
                        <group name="provider_config">
                            <field name="provider_type" required="1" />
                            <field name="api_key" password="True" required="1" />
                            <field
                                name="api_base_url"
                                placeholder="Leave empty for default"
                            />
                            <field name="organization_id" />
                            <field name="active" />
                        </group>
                        <group name="default_settings">
                            <field name="default_model" required="1" />
                            <field name="default_temperature" />
                            <field name="default_max_tokens" />
                        </group>
                    </group>

                    <group name="extra_info">
                        <group string="Statistics">
                            <field name="total_requests" />
                            <field name="total_tokens_used" />
                            <field name="last_request_date" />
                        </group>
                        <group string="Error Information" invisible="state != 'error'">
                            <field name="error_message" nolabel="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">chatroom.ai.provider</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
