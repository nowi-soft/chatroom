<odoo>
    <!-- Server action to launch Discuss-based agent setup -->
    <record id="action_chatroom_ai_agent_setup_discuss" model="ir.actions.server">
        <field name="name">New Agent Setup</field>
        <field
            name="model_id"
            ref="chatroom_ai.model_chatroom_ai_agent_setup_session"
        />
        <field name="state">code</field>
        <field name="code">action = model.action_start_setup()</field>
    </record>

    <menuitem
        id="menu_chatroom_ai"
        name="AI Agents"
        parent="chatroom.menu_chatroom_config"
        sequence="50"
        groups="chatroom_ai.group_chatroom_ai_manager"
    />

    <menuitem
        id="menu_chatroom_ai_agents"
        name="Agents"
        parent="menu_chatroom_ai"
        action="action_chatroom_ai_agent"
        sequence="10"
    />

    <menuitem
        id="menu_chatroom_ai_providers"
        name="AI Providers"
        parent="menu_chatroom_ai"
        action="action_chatroom_ai_provider"
        sequence="20"
    />

    <menuitem
        id="menu_chatroom_ai_knowledge"
        name="Knowledge Base"
        parent="menu_chatroom_ai"
        action="action_chatroom_ai_knowledge"
        sequence="30"
    />

    <menuitem
        id="menu_chatroom_ai_tools"
        name="Tools &amp; Actions"
        parent="menu_chatroom_ai"
        action="action_chatroom_ai_tool"
        sequence="40"
    />

    <menuitem
        id="menu_chatroom_ai_agent_setup"
        name="New Agent Setup"
        parent="menu_chatroom_ai"
        action="chatroom_ai.action_chatroom_ai_agent_setup_discuss"
        sequence="5"
    />
</odoo>
