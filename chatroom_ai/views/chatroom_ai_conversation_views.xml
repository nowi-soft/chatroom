<odoo>
    <record id="view_chatroom_ai_conversation_search" model="ir.ui.view">
        <field name="name">chatroom.ai.conversation.search</field>
        <field name="model">chatroom.ai.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_id" />
                <field name="agent_id" />
                <separator />
                <filter
                    string="Active"
                    name="active"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    string="Paused"
                    name="paused"
                    domain="[('state', '=', 'paused')]"
                />
                <filter
                    string="Completed"
                    name="completed"
                    domain="[('state', '=', 'completed')]"
                />
                <filter
                    string="Error"
                    name="error"
                    domain="[('state', '=', 'error')]"
                />
                <group>
                    <filter
                        name="group_by_agent"
                        string="Agent"
                        context="{'group_by': 'agent_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_chatroom_ai_conversation_tree" model="ir.ui.view">
        <field name="name">chatroom.ai.conversation.tree</field>
        <field name="model">chatroom.ai.conversation</field>
        <field name="arch" type="xml">
            <list string="AI Conversations">
                <field name="room_id" />
                <field name="agent_id" />
                <field
                    name="state"
                    decoration-success="state == 'completed'"
                    decoration-warning="state == 'paused'"
                    decoration-danger="state == 'error'"
                />
                <field name="message_count" />
                <field name="ai_responses" />
                <field name="human_messages" />
                <field name="start_date" />
                <field name="last_message_date" />
            </list>
        </field>
    </record>

    <record id="view_chatroom_ai_conversation_form" model="ir.ui.view">
        <field name="name">chatroom.ai.conversation.form</field>
        <field name="model">chatroom.ai.conversation</field>
        <field name="arch" type="xml">
            <form string="AI Conversation">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="room_id" />
                            <field name="agent_id" />
                        </group>
                        <group>
                            <field name="message_count" />
                            <field name="ai_responses" />
                            <field name="human_messages" />
                            <field name="tool_executions" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date" />
                            <field name="last_message_date" />
                        </group>
                        <group>
                            <field name="error_message" invisible="state != 'error'" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_ai_conversation" model="ir.actions.act_window">
        <field name="name">AI Conversations</field>
        <field name="res_model">chatroom.ai.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
