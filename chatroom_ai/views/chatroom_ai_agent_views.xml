<odoo>
    <record id="view_chatroom_ai_agent_search" model="ir.ui.view">
        <field name="name">chatroom.ai.agent.search</field>
        <field name="model">chatroom.ai.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="provider_id" />
                <separator />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="view_chatroom_ai_agent_tree" model="ir.ui.view">
        <field name="name">chatroom.ai.agent.tree</field>
        <field name="model">chatroom.ai.agent</field>
        <field name="arch" type="xml">
            <list string="AI Agents" decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="provider_id" />
                <field name="active" invisible="1" />
                <field name="total_responses" />
                <field name="active_conversation_count" />
                <field name="last_response_date" />
            </list>
        </field>
    </record>

    <record id="view_chatroom_ai_agent_form" model="ir.ui.view">
        <field name="name">chatroom.ai.agent.form</field>
        <field name="model">chatroom.ai.agent</field>
        <field name="arch" type="xml">
            <form string="AI Agent">
                <header>
                    <button
                        name="action_view_conversations"
                        type="object"
                        string="View Conversations"
                        class="btn-secondary"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="AI Agent Name" />
                        </h1>
                    </div>
                    <group>
                        <group name="basic_config">
                            <field name="provider_id" required="1" />
                            <field
                                name="model"
                                placeholder="Leave empty for provider default"
                            />
                            <field name="temperature" />
                            <field name="max_tokens" />
                            <field name="response_delay" />
                        </group>
                        <group name="stats">
                            <field name="total_responses" />
                            <field name="total_tool_executions" />
                            <field name="human_interventions" />
                            <field name="active_conversation_count" />
                            <field name="last_response_date" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Instructions" name="instructions">
                            <group>
                                <field name="system_prompt" widget="text" nolabel="1" />
                            </group>
                        </page>

                        <page string="Knowledge Base" name="knowledge">
                            <field
                                name="knowledge_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'sequence'}"
                            />
                            <separator string="Knowledge Summary" />
                            <field name="knowledge_summary" readonly="1" />
                        </page>

                        <page string="Tools &amp; Actions" name="tools">
                            <field name="tool_ids">
                                <list>
                                    <field name="name" />
                                    <field name="code_name" />
                                    <field name="description" />
                                    <field name="execution_count" />
                                </list>
                            </field>
                        </page>

                        <page string="Active Conversations" name="conversations">
                            <field
                                name="conversation_ids"
                                context="{'default_agent_id': id}"
                            >
                                <list>
                                    <field name="room_id" />
                                    <field
                                        name="state"
                                        decoration-success="state == 'active'"
                                        decoration-warning="state in ['paused', 'pending_approval']"
                                    />
                                    <field name="message_count" />
                                    <field name="ai_responses" />
                                    <field name="human_messages" />
                                    <field name="start_date" />
                                    <field name="last_message_date" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_ai_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">chatroom.ai.agent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Agent
            </p>
            <p>
                AI Agents can automatically respond to chat messages using artificial intelligence.
                Configure the agent's behavior, knowledge base, and available tools.
            </p>
        </field>
    </record>
</odoo>
