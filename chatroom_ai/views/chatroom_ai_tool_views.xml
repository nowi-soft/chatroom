<odoo>
    <record id="view_chatroom_ai_tool_search" model="ir.ui.view">
        <field name="name">chatroom.ai.tool.search</field>
        <field name="model">chatroom.ai.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code_name" />
                <separator />
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="view_chatroom_ai_tool_tree" model="ir.ui.view">
        <field name="name">chatroom.ai.tool.tree</field>
        <field name="model">chatroom.ai.tool</field>
        <field name="arch" type="xml">
            <list string="AI Tools">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code_name" />
            </list>
        </field>
    </record>

    <record id="view_chatroom_ai_tool_form" model="ir.ui.view">
        <field name="name">chatroom.ai.tool.form</field>
        <field name="model">chatroom.ai.tool</field>
        <field name="arch" type="xml">
            <form string="AI Tool">
                <header>
                    <button
                        name="action_test_tool"
                        type="object"
                        string="Test Tool"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tool Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="code_name"
                                placeholder="e.g., create_lead, send_email"
                            />
                        </group>
                    </group>

                    <notebook>
                        <page string="Description &amp; Parameters" name="definition">
                            <group>
                                <field
                                    name="description"
                                    widget="text"
                                    placeholder="Describe what this tool does. Be clear and specific - the AI will use this to decide when to call the tool."
                                />
                            </group>
                            <separator string="Parameters Schema (JSON)" />
                            <field
                                name="parameters_schema"
                                widget="code"
                                options="{'mode': 'javascript'}"
                            />
                        </page>

                        <page string="Implementation" name="implementation">
                            <field
                                name="python_code"
                                widget="code"
                                options="{'mode': 'python'}"
                                nolabel="1"
                            />
                        </page>

                        <page string="Example Usage" name="example">
                            <field
                                name="example_usage"
                                widget="text"
                                placeholder="Provide an example of when and how the AI should use this tool..."
                            />
                        </page>

                        <page string="Help" name="help">
                            <div
                                class="o_chatroom_ai_tool_help"
                                style="max-width: 980px; padding: 8px 0;"
                            >
                                <div
                                    class="alert alert-info"
                                    role="alert"
                                    style="margin-bottom: 16px;"
                                >
                                    Use this page as a quick reference when writing Python tools.
                                </div>

                                <h3 style="margin: 0 0 8px 0;">Execution Context</h3>
                                <p style="margin: 0 0 10px 0;">
                                    These variables are already available in <b
                                >python_code</b>:
                                    <b>env</b>, <b>room</b>, <b>params</b>, <b
                                >conversation</b>, <b>agent</b>,
                                    <b>json</b>, <b>fields</b>, <b>UserError</b>, <b
                                >_logger</b>.
                                </p>
                                <p
                                    style="margin: 0 0 16px 0;"
                                >Return values using a variable named <b
                                >result</b> (dict preferred).</p>

                                <h3
                                    style="margin: 0 0 8px 0;"
                                >Imports and Libraries</h3>
                                <p style="margin: 0 0 10px 0;">
                                    You can import Python modules available in the Odoo server environment.
                                    If a module is not installed, the tool will fail with ImportError.
                                </p>
                                <p style="margin: 0 0 16px 0;">
                                    Useful imports: <b
                                >from markupsafe import Markup</b>, <b>import json</b>,
                                    <b>import re</b>, <b
                                >from datetime import datetime</b>,
                                    <b>from odoo.exceptions import UserError</b>.
                                </p>

                                <h3 style="margin: 0 0 8px 0;">Examples</h3>
                                <p style="margin: 0 0 4px 0;">
                                    <b>1) Minimal successful tool</b>
                                </p>
                                <pre
                                    style="white-space: pre-wrap; background: #f8f9fa; border: 1px solid #e2e3e5; border-radius: 6px; padding: 10px; margin: 0 0 12px 0;"
                                >result = {
    'success': True,
    'message': 'Done',
}</pre>

                                <p style="margin: 0 0 4px 0;">
                                    <b>2) Validate required params</b>
                                </p>
                                <pre
                                    style="white-space: pre-wrap; background: #f8f9fa; border: 1px solid #e2e3e5; border-radius: 6px; padding: 10px; margin: 0 0 12px 0;"
                                >name = (params.get('name') or '').strip()
if not name:
    raise UserError('Parameter "name" is required')

result = {'success': True, 'name': name}</pre>

                                <p style="margin: 0 0 4px 0;">
                                    <b>3) Post rendered HTML message (Markup)</b>
                                </p>
                                <pre
                                    style="white-space: pre-wrap; background: #f8f9fa; border: 1px solid #e2e3e5; border-radius: 6px; padding: 10px; margin: 0 0 16px 0;"
                                >from markupsafe import Markup

lead = env['crm.lead'].browse(params['lead_id'])
chat_url = f"/web#action=chatroom.action_chatroom_app&amp;room_id={room.id}"
body = f"&lt;p&gt;Created by &lt;strong&gt;{agent.name}&lt;/strong&gt;&lt;/p&gt;"
body += f"&lt;p&gt;&lt;a href='{chat_url}' target='_blank'&gt;Open chat&lt;/a&gt;&lt;/p&gt;"

lead.message_post(body=Markup(body), subtype_xmlid='mail.mt_note')
result = {'success': True}</pre>

                                <h3 style="margin: 0 0 8px 0;">Debugging Tips</h3>
                                <p style="margin: 0;">Use <b
                                >_logger.info(...)</b> to inspect params and flow.</p>
                                <p
                                    style="margin: 0;"
                                >Keep output as simple dicts (avoid recordsets in result).</p>
                                <p
                                    style="margin: 0;"
                                >Wrap risky logic in try/except and return clear error messages.</p>
                                <p style="margin: 0;">Use the <b
                                >Test Tool</b> button before assigning to agents.</p>
                            </div>
                        </page>

                        <page string="Used by Agents" name="agents">
                            <field name="agent_ids">
                                <list>
                                    <field name="name" />
                                    <field name="provider_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_chatroom_ai_tool" model="ir.actions.act_window">
        <field name="name">AI Tools</field>
        <field name="res_model">chatroom.ai.tool</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create AI tools and actions
            </p>
            <p>
                Tools allow AI agents to perform actions like creating leads, sending emails,
                updating records, etc. Define what the tool does and when it should be used.
            </p>
        </field>
    </record>
</odoo>
