<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_chatroom_ai">
        <field name="name">ChatRoom AI</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="chatroom.module_category_chatroom" />
    </record>

    <record id="group_chatroom_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="comment">Can view and interact with AI agents</field>
        <field name="privilege_id" ref="res_groups_privilege_chatroom_ai" />
        <field
            name="implied_ids"
            eval="[(4, ref('base.group_user')), (4, ref('chatroom.group_chatroom_user'))]"
        />
    </record>

    <record id="group_chatroom_ai_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field
            name="comment"
        >Can configure AI agents, providers, knowledge base, and tools</field>
        <field name="privilege_id" ref="res_groups_privilege_chatroom_ai" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_chatroom_ai_user')), (4, ref('chatroom.group_chatroom_manager'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="chatroom_ai_agent_user_rule" model="ir.rule">
        <field name="name">AI Agent: users see all</field>
        <field name="model_id" ref="model_chatroom_ai_agent" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_user'))]" />
    </record>

    <record id="chatroom_ai_provider_manager_rule" model="ir.rule">
        <field name="name">AI Provider: managers only</field>
        <field name="model_id" ref="model_chatroom_ai_provider" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_manager'))]" />
    </record>

    <record id="chatroom_ai_knowledge_user_rule" model="ir.rule">
        <field name="name">AI Knowledge: users see all</field>
        <field name="model_id" ref="model_chatroom_ai_knowledge" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="chatroom_ai_knowledge_manager_rule" model="ir.rule">
        <field name="name">AI Knowledge: managers full access</field>
        <field name="model_id" ref="model_chatroom_ai_knowledge" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_manager'))]" />
    </record>

    <record id="chatroom_ai_tool_user_rule" model="ir.rule">
        <field name="name">AI Tool: users see all</field>
        <field name="model_id" ref="model_chatroom_ai_tool" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="chatroom_ai_tool_manager_rule" model="ir.rule">
        <field name="name">AI Tool: managers full access</field>
        <field name="model_id" ref="model_chatroom_ai_tool" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_manager'))]" />
    </record>

    <record id="chatroom_ai_conversation_user_rule" model="ir.rule">
        <field name="name">AI Conversation: user access via room</field>
        <field name="model_id" ref="model_chatroom_ai_conversation" />
        <field
            name="domain_force"
        >[('room_id.assigned_to_id', 'in', [user.id, False])]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_user'))]" />
    </record>

    <record id="chatroom_ai_conversation_manager_rule" model="ir.rule">
        <field name="name">AI Conversation: managers see all</field>
        <field name="model_id" ref="model_chatroom_ai_conversation" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_ai_manager'))]" />
    </record>
</odoo>
