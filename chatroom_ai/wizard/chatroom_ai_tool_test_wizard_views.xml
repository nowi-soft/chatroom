<odoo>
    <record id="view_chatroom_ai_tool_test_wizard_form" model="ir.ui.view">
        <field name="name">chatroom.ai.tool.test.wizard.form</field>
        <field name="model">chatroom.ai.tool.test.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="state == 'done'">
                    <group>
                        <field name="tool_id" readonly="1" />
                        <field name="agent_id" />
                        <field name="room_id" />
                    </group>
                    <group>
                        <field name="test_params" widget="code" />
                    </group>
                </group>

                <group invisible="state != 'done'">
                    <field name="result" widget="code" nolabel="1" />
                </group>

                <field name="state" invisible="1" />

                <footer>
                    <button
                        name="action_run_test"
                        string="Run Test"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'done'"
                    />
                    <button string="Close" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
