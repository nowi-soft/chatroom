<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_muk_ai_agent_form_inherit_knowledge" model="ir.ui.view">
        <field name="name">muk_ai.agent.form.inherit.knowledge</field>
        <field name="model">muk_ai.agent</field>
        <field name="inherit_id" ref="muk_ai.view_ai_agent_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Knowledge">
                    <group>
                        <field name="kb_mode" />
                    </group>
                    <field name="knowledge_ids">
                        <list>
                            <field name="name" />
                            <field name="content_type" />
                            <field name="char_count" />
                            <field
                                name="processing_status"
                                widget="badge"
                                decoration-success="processing_status == 'success'"
                                decoration-danger="processing_status == 'error'"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
