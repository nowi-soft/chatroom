<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_muk_ai_knowledge_list" model="ir.ui.view">
        <field name="name">muk_ai.knowledge.list</field>
        <field name="model">muk_ai.knowledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="content_type" />
                <field name="char_count" />
                <field
                    name="processing_status"
                    widget="badge"
                    decoration-success="processing_status == 'success'"
                    decoration-danger="processing_status == 'error'"
                />
                <field name="last_updated" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_muk_ai_knowledge_form" model="ir.ui.view">
        <field name="name">muk_ai.knowledge.form</field>
        <field name="model">muk_ai.knowledge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_process_content"
                            type="object"
                            string="Reprocess Content"
                            class="oe_stat_button"
                            icon="fa-refresh"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="content_type" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="char_count" />
                            <field
                                name="processing_status"
                                widget="badge"
                                decoration-success="processing_status == 'success'"
                                decoration-danger="processing_status == 'error'"
                            />
                            <field name="last_updated" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                    <notebook>
                        <page string="Content" invisible="content_type == 'file'">
                            <field name="content" widget="text" />
                        </page>
                        <page string="File" invisible="content_type != 'file'">
                            <field name="file" filename="file_name" />
                            <field name="file_name" />
                        </page>
                        <page string="Processed Content (read-only)">
                            <field
                                name="processed_content"
                                readonly="1"
                                widget="text"
                            />
                            <field name="processing_message" readonly="1" />
                        </page>
                        <page string="Linked Agents">
                            <field name="agent_ids" widget="many2many_tags" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_muk_ai_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge Bases</field>
        <field name="res_model">muk_ai.knowledge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
