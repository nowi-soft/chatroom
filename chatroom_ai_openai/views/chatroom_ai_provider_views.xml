<odoo>
    <record id="view_chatroom_ai_provider_form_openai" model="ir.ui.view">
        <field name="name">chatroom.ai.provider.form.openai</field>
        <field name="model">chatroom.ai.provider</field>
        <field name="inherit_id" ref="chatroom_ai.view_chatroom_ai_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_model']" position="attributes">
                <attribute
                    name="placeholder"
                    add="provider_type == 'openai' and 'gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo' or ''"
                />
            </xpath>

            <xpath expr="//field[@name='organization_id']" position="attributes">
                <attribute name="invisible">provider_type != 'openai'</attribute>
            </xpath>

            <xpath expr="//group[@name='extra_info']" position="inside">
                <group
                    string="OpenAI Specific Settings"
                    invisible="provider_type != 'openai'"
                >
                    <field
                        name="extra_config"
                        widget="code"
                        options="{'mode': 'javascript'}"
                        placeholder='{"seed": null, "top_p": 1.0}'
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
