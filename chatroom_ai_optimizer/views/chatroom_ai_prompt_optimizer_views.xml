<odoo>
    <record id="action_chatroom_ai_prompt_optimizer" model="ir.actions.act_window">
        <field name="name">Prompt Optimizers</field>
        <field name="res_model">chatroom.ai.prompt.optimizer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Prompt Optimizer
            </p>
            <p>
                Optimizers automatically test and improve your AI agent's prompts using simulated conversations.
            </p>
        </field>
    </record>

    <record id="view_chatroom_ai_prompt_optimizer_form" model="ir.ui.view">
        <field name="name">chatroom.ai.prompt.optimizer.form</field>
        <field name="model">chatroom.ai.prompt.optimizer</field>
        <field name="arch" type="xml">
            <form string="Prompt Optimizer" class="o_form_sheet_width_full">
                <header>
                    <button
                        name="action_generate_test_scenarios"
                        type="object"
                        string="Generate Test Scenarios"
                        class="btn-secondary"
                        invisible="not active"
                    />
                    <button
                        name="action_run_optimization"
                        type="object"
                        string="Run Optimization Now"
                        class="oe_highlight"
                        invisible="not active"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Inactive"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />

                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Customer Support Optimizer"
                            />
                        </h1>
                    </div>

                    <group>
                        <group name="basic">
                            <field name="agent_id" options="{'no_create': True}" />
                        </group>
                        <group name="schedule">
                            <field name="last_optimization_date" readonly="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Configuration" name="config">
                            <group>
                                <group string="Testing">
                                    <field name="test_scenarios_count" />
                                    <field name="max_optimization_attempts" />
                                    <field name="evaluator_temperature" />
                                    <field name="optimizer_temperature" />
                                </group>
                            </group>
                            <separator string="Custom Test Scenarios" />
                            <field
                                name="test_scenario_prompts"
                                nolabel="1"
                                widget="text"
                                placeholder="One scenario per line, e.g.:&#10;How do I reset my password?&#10;I want to cancel my subscription&#10;&#10;Leave empty for auto-generated scenarios"
                            />
                        </page>

                        <page string="Optimization History" name="history">
                            <field name="run_ids" nolabel="1">
                                <list>
                                    <field name="create_date" string="Date" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'completed'"
                                        decoration-danger="state == 'failed'"
                                        decoration-info="state == 'running'"
                                    />
                                    <field name="current_score" />
                                    <field name="new_score" />
                                    <field
                                        name="improvement"
                                        decoration-success="improvement &gt; 0"
                                        decoration-danger="improvement &lt; 0"
                                    />
                                    <field
                                        name="result"
                                        widget="badge"
                                        decoration-success="result == 'improved'"
                                        decoration-warning="result == 'no_improvement'"
                                    />
                                    <button
                                        name="action_apply_improved_prompt"
                                        type="object"
                                        string="Apply to Agent"
                                        icon="fa-check"
                                        class="btn-primary"
                                        invisible="result != 'improved'"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chatroom_ai_prompt_optimizer_list" model="ir.ui.view">
        <field name="name">chatroom.ai.prompt.optimizer.list</field>
        <field name="model">chatroom.ai.prompt.optimizer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="agent_id" />
                <field name="total_optimizations" />
                <field name="total_improvements" />
                <field name="last_optimization_date" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>
</odoo>
