<templates xml:space="preserve">

    <t t-name="chatroom.ChatroomApp">
        <Layout display="{ controlPanel: false }" className="'h-100'">
            <div class="o_ChatroomApp">
                <div class="chatroom-sidebar">
                    <t t-if="!state.showClosedChats">
                        <div class="chat-section my-chats">
                            <div class="section-header">
                                <h3>Chats</h3>
                                <div class="header-actions">
                                    <span class="badge" t-esc="state.myChats.length" />
                                    <button
                                        class="btn btn-sm btn-link header-btn"
                                        t-on-click="openAiCreator"
                                        title="Configurar AI"
                                    >
                                        <i class="fa fa-magic" />
                                    </button>
                                    <button
                                        class="btn btn-sm btn-link header-btn"
                                        t-on-click="toggleClosedChats"
                                        title="View Closed Chats"
                                    >
                                        <i class="fa fa-archive" />
                                    </button>
                                </div>
                            </div>
                            <div class="chat-list">
                                <t
                                    t-foreach="state.myChats"
                                    t-as="chat"
                                    t-key="chat.id"
                                >
                                    <div
                                        class="chat-item"
                                        t-att-class="{
                                            active: state.currentRoom?.id === chat.id,
                                            'needs-attention': chat.needs_attention,
                                        }"
                                        t-on-click="() => this.selectChat(chat)"
                                    >
                                        <div class="chat-item-header">
                                            <div class="chat-name" t-esc="chat.name" />
                                            <div class="btn-group-sm">
                                                <button
                                                    class="btn btn-sm btn-outline-secondary assign-btn"
                                                    t-on-click.stop="() => this.unassignChat(chat.id)"
                                                    title="Unassign"
                                                >
                                                    <i class="fa fa-user-times" />
                                                </button>
                                                <button
                                                    class="btn btn-sm btn-outline-danger assign-btn"
                                                    t-on-click.stop="() => this.closeChat(chat.id)"
                                                    title="Close"
                                                >
                                                    <i class="fa fa-times" />
                                                </button>
                                            </div>
                                        </div>
                                        <div
                                            class="chat-preview"
                                            t-esc="chat.last_message_preview"
                                        />
                                        <div class="chat-meta">
                                            <div class="chat-assigned-to">
                                                <i class="fa fa-user" />
                                                <span t-esc="chat.assigned_to_id[1]" />
                                            </div>
                                            <div
                                                t-if="chat.muk_ai_agent_id"
                                                class="chat-ai-badge"
                                                t-att-class="{'ai-active': chat.ai_active, 'ai-paused': !chat.ai_active}"
                                                t-att-title="'AI: ' + (chat.muk_ai_agent_id[1] || '')"
                                            >
                                                <i class="fa fa-android" />
                                            </div>
                                            <div
                                                t-if="chat.connector_id"
                                                class="chat-connector-badge"
                                            >
                                                <i class="fa fa-plug" />
                                                <span t-esc="chat.connector_id[1]" />
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <div t-if="!state.myChats.length" class="empty-state">
                            No chats assigned
                        </div>
                            </div>
                        </div>

                        <div class="chat-section unassigned-chats">
                            <div class="section-header">
                                <h3>Unassigned</h3>
                                <span
                                    class="badge"
                                    t-esc="state.unassignedChats.length"
                                />
                            </div>
                            <div class="chat-list">
                                <t
                                    t-foreach="state.unassignedChats"
                                    t-as="chat"
                                    t-key="chat.id"
                                >
                                    <div
                                        class="chat-item"
                                        t-att-class="{
                                            active: state.currentRoom?.id === chat.id,
                                            'needs-attention': chat.needs_attention,
                                        }"
                                        t-on-click="() => this.selectChat(chat)"
                                    >
                                        <div class="chat-item-header">
                                            <div class="chat-name" t-esc="chat.name" />
                                            <button
                                                class="btn btn-sm btn-primary assign-btn"
                                                t-on-click.stop="() => this.assignToMe(chat.id)"
                                            >
                                        Take
                                    </button>
                                        </div>
                                        <div
                                            class="chat-preview"
                                            t-esc="chat.last_message_preview"
                                        />
                                        <div
                                            t-if="chat.connector_id"
                                            class="chat-connector-badge"
                                        >
                                            <i class="fa fa-plug" />
                                            <span t-esc="chat.connector_id[1]" />
                                        </div>
                                    </div>
                                </t>
                                <div
                                    t-if="!state.unassignedChats.length"
                                    class="empty-state"
                                >
                            No unassigned chats
                        </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="state.showClosedChats">
                        <div class="chat-section closed-chats-full">
                            <div class="section-header">
                                <h3>Closed Chats</h3>
                                <button
                                    class="btn btn-sm btn-link header-btn"
                                    t-on-click="toggleClosedChats"
                                    title="Back to Active Chats"
                                >
                                    <i class="fa fa-arrow-left" />
                                </button>
                            </div>
                            <div class="search-box">
                                <input
                                    type="text"
                                    class="form-control form-control-sm"
                                    placeholder="Search closed chats..."
                                    t-model="state.searchQuery"
                                />
                            </div>
                            <div class="chat-list">
                                <t
                                    t-foreach="filteredClosedChats"
                                    t-as="chat"
                                    t-key="chat.id"
                                >
                                    <div
                                        class="chat-item closed"
                                        t-att-class="{ active: state.currentRoom?.id === chat.id }"
                                        t-on-click="() => this.selectChat(chat)"
                                    >
                                        <div class="chat-item-header">
                                            <div class="chat-name" t-esc="chat.name" />
                                            <div class="dropdown">
                                                <button
                                                    class="btn btn-sm btn-link dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                >
                                                    <i class="fa fa-ellipsis-v" />
                                                </button>
                                                <ul
                                                    class="dropdown-menu dropdown-menu-end"
                                                >
                                                    <li>
                                                        <a
                                                            class="dropdown-item"
                                                            t-on-click.stop="() => this.reopenChatAssigned(chat.id)"
                                                        >
                                                        <i
                                                            class="fa fa-user"
                                                        /> Reopen (Assign to me)
                                                    </a>
                                                    </li>
                                                    <li>
                                                        <a
                                                            class="dropdown-item"
                                                            t-on-click.stop="() => this.reopenChatUnassigned(chat.id)"
                                                        >
                                                        <i
                                                            class="fa fa-inbox"
                                                        /> Reopen (Unassigned)
                                                    </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div
                                            class="chat-preview"
                                            t-esc="chat.last_message_preview"
                                        />
                                        <div
                                            t-if="chat.connector_id"
                                            class="chat-connector-badge"
                                        >
                                            <i class="fa fa-plug" />
                                            <span t-esc="chat.connector_id[1]" />
                                        </div>
                                    </div>
                                </t>
                                <div
                                    t-if="!filteredClosedChats.length"
                                    class="empty-state"
                                >
                                No closed chats
                            </div>
                            </div>
                        </div>
                    </t>
                </div>

                <div
                    class="chatroom-messages"
                    t-on-dragover.prevent="onDragOverMessage"
                    t-on-drop="onDropToMessage"
                >
                    <t t-if="state.currentRoom">
                        <div class="messages-header">
                            <div class="header-left">
                                <h2 t-esc="state.currentRoom.name" />
                            </div>
                            <div class="header-right">
                                <div class="related-records-widget">
                                    <t t-if="state.relatedRecords.length">
                                        <t
                                            t-foreach="state.relatedRecords"
                                            t-as="rel"
                                            t-key="rel.model + '_' + rel.id"
                                        >
                                            <span
                                                class="related-badge"
                                                t-on-click="() => this.openRelatedRecord(rel.model, rel.id)"
                                                t-att-title="rel.display_name"
                                            >
                                                <i
                                                    t-if="rel.model === 'res.partner'"
                                                    class="fa fa-user"
                                                />
                                                <i
                                                    t-elif="rel.model === 'product.product'"
                                                    class="fa fa-cube"
                                                />
                                                <i t-else="" class="fa fa-link" />
                                                <span t-esc="rel.name" />
                                                <i
                                                    class="fa fa-times"
                                                    t-on-click.stop="() => this.unlinkRecord(rel.model, rel.id, rel.field_name)"
                                                />
                                            </span>
                                        </t>
                                    </t>

                                    <button
                                        t-if="state.currentRoom.muk_ai_agent_id"
                                        class="btn btn-sm ai-toggle-btn"
                                        t-att-class="state.currentRoom.ai_active ? 'btn-success' : 'btn-outline-secondary'"
                                        t-on-click="() => this.toggleAiActive(state.currentRoom)"
                                        t-att-title="state.currentRoom.ai_active ? 'AI activo — click para pausar' : 'AI pausado — click para activar'"
                                    >
                                        <i class="fa fa-android" />
                                        <span
                                            class="ms-1"
                                            t-esc="state.currentRoom.ai_active ? 'IA activa' : 'IA en pausa'"
                                        />
                                    </button>
                                    <button
                                        class="btn btn-sm btn-link"
                                        t-on-click="shareChatLink"
                                        title="Copy shareable link"
                                    >
                                        <i class="fa fa-share-alt" />
                                    </button>

                                    <button
                                        class="btn btn-sm btn-link"
                                        t-on-click="() => this.closeChat(state.currentRoom.id)"
                                        title="Close Chat"
                                    >
                                        <i class="fa fa-times-circle" />
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="messages-list">
                            <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                                <div
                                    class="message"
                                    t-att-class="{ 'message-incoming': msg.direction === 'incoming' and !msg.is_internal,
                                               'message-outgoing': msg.direction === 'outgoing' and !msg.is_internal,
                                               'message-note': msg.is_internal }"
                                >
                                    <div class="message-author">
                                        <span t-esc="msg.author_name" />
                                        <span
                                            t-if="msg.is_internal"
                                            class="badge bg-secondary ms-2"
                                        >Internal Note</span>
                                        <span
                                            t-if="msg.message_type === 'image'"
                                            class="badge bg-success ms-2"
                                        >
                                            <i class="fa fa-image" /> Image
                                        </span>
                                        <span
                                            t-if="msg.message_type === 'audio'"
                                            class="badge bg-info ms-2"
                                        >
                                            <i class="fa fa-microphone" /> Audio
                                        </span>
                                        <span
                                            t-if="msg.message_type === 'file'"
                                            class="badge bg-warning ms-2"
                                        >
                                            <i class="fa fa-file" /> File
                                        </span>
                                    </div>
                                    <t
                                        t-if="msg.message_type === 'audio' and msg.file_url"
                                    >
                                        <div class="message-audio">
                                            <audio
                                                controls="controls"
                                                preload="metadata"
                                                t-att-src="msg.file_url"
                                            >
                                                Your browser does not support the audio element.
                                            </audio>
                                            <div class="audio-caption" />
                                        </div>
                                    </t>
                                    <t
                                        t-elif="msg.message_type === 'image' and msg.file_url"
                                    >
                                        <div class="message-image">
                                            <img
                                                t-att-src="msg.file_url"
                                                t-att-alt="msg.filename or 'Image'"
                                                class="chat-image"
                                                style="max-width: 300px; max-height: 300px; border-radius: 8px; cursor: pointer;"
                                                t-on-click="() => this.openImageModal(msg.file_url, msg.filename)"
                                            />
                                            <div
                                                t-if="msg.body and msg.body !== msg.filename and msg.body.trim()"
                                                class="image-caption"
                                                t-out="msg.body"
                                            />
                                        </div>
                                    </t>
                                    <t
                                        t-elif="msg.message_type === 'file' and msg.file_url"
                                    >
                                        <div class="message-file">
                                            <a
                                                t-att-href="msg.file_url"
                                                target="_blank"
                                                class="file-link"
                                            >
                                                <i class="fa fa-download" />
                                                <span
                                                    t-esc="msg.filename or 'Download file'"
                                                />
                                            </a>
                                            <div
                                                t-if="msg.body and msg.body !== msg.filename and msg.body.trim()"
                                                class="file-caption"
                                                t-out="msg.body"
                                            />
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="message-body" t-out="msg.body" />
                                    </t>
                                    <t t-if="msg.product">
                                        <div class="message-product">
                                            <img
                                                t-if="msg.product.image"
                                                t-att-src="'data:image/png;base64,' + msg.product.image"
                                                class="product-image"
                                            />
                                            <div class="product-info">
                                                <strong t-esc="msg.product.name" />
                                                <div t-esc="'$' + msg.product.price" />
                                            </div>
                                        </div>
                                    </t>
                                    <div class="message-time" t-esc="msg.create_date" />
                                </div>
                            </t>
                        </div>

                        <div
                            class="messages-input"
                            t-if="state.currentRoom.state !== 'closed'"
                        >
                            <textarea
                                class="form-control"
                                placeholder="Type a message..."
                                t-model="state.messageInput"
                                t-on-keydown="onMessageInputKeydown"
                                rows="4"
                            />
                            <div class="input-actions">
                                <div class="attachment-buttons">
                                    <input
                                        type="file"
                                        t-ref="fileInput"
                                        style="display: none;"
                                        t-on-change="onFileSelected"
                                        multiple="true"
                                    />
                                    <button
                                        class="btn btn-sm btn-outline-secondary"
                                        t-on-click="() => this.fileInputRef.el.click()"
                                        title="Attach file"
                                    >
                                        <i class="fa fa-paperclip" />
                                    </button>
                                    <button
                                        type="button"
                                        class="btn"
                                        t-att-class="state.isRecordingAudio ? 'btn-danger recording-pulse' : 'btn-outline-secondary'"
                                        t-on-click="toggleAudioRecording"
                                        t-att-title="state.isRecordingAudio ? 'Stop recording' : 'Record audio'"
                                    >
                                        <i class="fa fa-microphone" />
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button
                                        class="btn btn-primary"
                                        t-on-click="sendMessage"
                                        title="Send message to external"
                                    >
                                    <i class="fa fa-paper-plane" /> Send
                                </button>
                                    <button
                                        class="btn btn-secondary"
                                        t-on-click="addInternalNote"
                                        title="Add internal note (not sent to external)"
                                    >
                                    <i class="fa fa-sticky-note" /> Note
                                </button>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="empty-state-center">
                            <h3>Select a chat to start</h3>
                        </div>
                    </t>
                </div>

                <div class="chatroom-mini-toolbar">
                    <t t-foreach="state.availableTabs" t-as="tab" t-key="tab.id">
                        <button
                            class="mini-tab-btn"
                            t-att-class="{ active: state.rightPanelTab === tab.id }"
                            t-on-click="() => this.selectRightPanelTab(tab.id)"
                            t-att-title="tab.name"
                        >
                            <i t-att-class="'fa ' + tab.icon" />
                        </button>
                    </t>
                </div>

                <div class="chatroom-resize-handle" t-on-mousedown="startResize" />

                <div
                    class="chatroom-right-panel"
                    t-att-style="'width: ' + state.rightPanelWidth + 'px'"
                >
                    <div class="right-panel-tabs">
                        <t t-foreach="state.availableTabs" t-as="tab" t-key="tab.id">
                            <h3
                                t-if="state.rightPanelTab === tab.id"
                                t-esc="tab.name"
                                class="panel-title"
                            />
                        </t>
                    </div>

                    <div class="right-panel-content">
                        <t t-foreach="state.availableTabs" t-as="tab" t-key="tab.id">
                            <t t-if="state.rightPanelTab === tab.id">
                                <t t-if="tab.id === 'quick_messages'">
                                    <div class="quick-messages-list">
                                        <t t-if="state.quickMessages.length">
                                            <t
                                                t-foreach="state.quickMessages"
                                                t-as="qm"
                                                t-key="qm.id"
                                            >
                                                <div class="quick-message-item">
                                                    <div class="quick-message-header">
                                                        <span
                                                            class="quick-message-title"
                                                            t-esc="qm.name"
                                                        />
                                                    </div>
                                                    <div
                                                        class="quick-message-text"
                                                        t-esc="qm.message"
                                                    />
                                                    <div class="quick-message-actions">
                                                        <button
                                                            class="btn-quick-action btn-quick-send"
                                                            t-on-click="() => this.sendQuickMessage(qm.message)"
                                                            title="Send message"
                                                        >
                                                            <i
                                                                class="fa fa-paper-plane"
                                                            />
                                                        </button>
                                                        <button
                                                            class="btn-quick-action btn-quick-copy"
                                                            t-on-click="() => this.copyQuickMessageToInput(qm.message)"
                                                            title="Copy to input"
                                                        >
                                                            <i class="fa fa-copy" />
                                                        </button>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="empty-quick-messages">
                                                <i class="fa fa-comments fa-3x" />
                                                <p>No quick messages configured</p>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <RecordList
                                        tab="tab"
                                        onRecordClick.bind="openRecord"
                                        onRecordLink.bind="linkRecordToChat"
                                        onRecordExpand.bind="openRecordFullScreen"
                                        onCreateRecord.bind="tab.id === 'contacts' ? createPartnerFromChat : null"
                                        onLinkExisting.bind="showLinkMode"
                                        linkMode="tab.id === 'contacts' ? state.linkContactMode : (tab.id === 'leads' ? state.linkLeadMode : false)"
                                        linkedRecordIds="tab.id === 'contacts' ? state.linkedContactIds : (tab.id === 'leads' ? state.linkedLeadIds : [])"
                                    />
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </Layout>

        <!-- Image Modal -->
        <div
            t-if="state.imageModalUrl"
            class="modal fade show"
            style="display: block; background-color: rgba(0,0,0,0.8);"
            t-on-click="closeImageModal"
        >
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-body text-center p-0">
                        <img
                            t-att-src="state.imageModalUrl"
                            t-att-alt="state.imageModalAlt"
                            style="max-width: 100%; max-height: 90vh; border-radius: 8px;"
                        />
                    </div>
                    <button
                        type="button"
                        class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                        t-on-click="closeImageModal"
                        style="z-index: 1;"
                    />
                </div>
            </div>
        </div>

        <div
            t-if="state.previewModal.show"
            class="modal fade show"
            style="display: block;"
            tabindex="-1"
        >
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <t
                                t-if="state.previewModal.type === 'audio'"
                            >Preview Audio</t>
                            <t
                                t-elif="state.previewModal.type === 'image'"
                            >Preview Image</t>
                            <t t-else="">Preview File</t>
                        </h5>
                        <button
                            type="button"
                            class="btn-close"
                            t-on-click="closePreviewModal"
                        />
                    </div>
                    <div class="modal-body text-center">
                        <t t-if="state.previewModal.type === 'audio'">
                            <audio
                                controls="controls"
                                preload="metadata"
                                t-att-src="state.previewModal.url"
                                style="width: 100%;"
                            >
                                Your browser does not support the audio element.
                            </audio>
                        </t>
                        <t t-elif="state.previewModal.type === 'image'">
                            <img
                                t-att-src="state.previewModal.url"
                                style="max-width: 100%; max-height: 400px; border-radius: 8px;"
                            />
                        </t>
                        <t t-else="">
                            <div class="file-preview p-4">
                                <i class="fa fa-file fa-3x mb-3" />
                                <p class="mb-0">
                                    <strong t-esc="state.previewModal.file?.name" />
                                </p>
                                <small class="text-muted">
                                    Size: <t
                                    t-esc="(state.previewModal.file?.size / 1024).toFixed(2)"
                                /> KB
                                </small>
                            </div>
                        </t>
                    </div>
                    <div class="modal-footer">
                        <button
                            type="button"
                            class="btn btn-primary"
                            t-on-click="confirmSendFile"
                        >
                            <i class="fa fa-paper-plane" /> Send
                        </button>
                        <button
                            type="button"
                            class="btn btn-secondary"
                            t-on-click="confirmSendFileAsNote"
                            title="Add internal note (not sent to external)"
                        >
                            <i class="fa fa-sticky-note" /> Note
                        </button>
                        <button
                            type="button"
                            class="btn btn-danger"
                            t-on-click="closePreviewModal"
                        >
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div t-if="state.previewModal.show" class="modal-backdrop fade show" />
    </t>

</templates>
