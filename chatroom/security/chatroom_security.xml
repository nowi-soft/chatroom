<odoo>
    <record id="group_chatroom_user" model="res.groups">
        <field name="name">ChatRoom: User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_chatroom_manager" model="res.groups">
        <field name="name">ChatRoom: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_chatroom_user'))]" />
    </record>

    <record id="chatroom_room_user_rule" model="ir.rule">
        <field name="name">ChatRoom: users see own and unassigned</field>
        <field name="model_id" ref="model_chatroom_room" />
        <field name="domain_force">[
            '|',
                ('assigned_to_id', '=', user.id),
                ('assigned_to_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]" />
    </record>

    <record id="chatroom_room_manager_rule" model="ir.rule">
        <field name="name">ChatRoom: managers see all</field>
        <field name="model_id" ref="model_chatroom_room" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_manager'))]" />
    </record>

    <record id="chatroom_message_user_rule" model="ir.rule">
        <field name="name">ChatRoom Message: user access</field>
        <field name="model_id" ref="model_chatroom_message" />
        <field name="domain_force">[
            '|',
                ('room_id.assigned_to_id', '=', user.id),
                ('room_id.assigned_to_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_user'))]" />
    </record>

    <record id="chatroom_message_manager_rule" model="ir.rule">
        <field name="name">ChatRoom Message: manager access</field>
        <field name="model_id" ref="model_chatroom_message" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_chatroom_manager'))]" />
    </record>
</odoo>
