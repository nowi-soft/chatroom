<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatroom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="90" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ChatRoom" string="ChatRoom" name="chatroom">
                    <block name="chatroom_messages_settings" title="Messages">
                        <setting
                            id="chatroom_show_author_name_setting"
                            help="Display the author name below each message in the chat interface"
                        >
                            <field name="chatroom_show_author_name" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
