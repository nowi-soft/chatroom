<odoo>
    <record id="view_chatroom_room_list" model="ir.ui.view">
        <field name="name">chatroom.room.list</field>
        <field name="model">chatroom.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="assigned_to_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_chatroom_room_form" model="ir.ui.view">
        <field name="name">chatroom.room.form</field>
        <field name="model">chatroom.room</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_open_chatroom"
                        string="Open in Chatroom"
                        type="object"
                        class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="assigned_to_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages" name="messages">
                            <field name="message_ids">
                                <list>
                                    <field name="create_date" />
                                    <field name="direction" />
                                    <field name="author_name" />
                                    <field name="body" />
                                    <field name="message_type" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chatroom_room_search" model="ir.ui.view">
        <field name="name">chatroom.room.search</field>
        <field name="model">chatroom.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="assigned_to_id" />
                <filter
                    string="My Chats"
                    name="my_chats"
                    domain="[('assigned_to_id', '=', uid)]"
                />
                <filter
                    string="Unassigned"
                    name="unassigned"
                    domain="[('assigned_to_id', '=', False)]"
                />
                <group>
                    <filter
                        string="Assigned To"
                        name="group_assigned"
                        context="{'group_by': 'assigned_to_id'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_chatroom_room" model="ir.actions.act_window">
        <field name="name">Chat Rooms</field>
        <field name="res_model">chatroom.room</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unassigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first chat room
            </p>
            <p>
                Chat rooms will appear here when customers start conversations.
            </p>
        </field>
    </record>
</odoo>
